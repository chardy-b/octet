[Unit]
Description=Verify an Octet DAC stall and perform one bounded recovery step

[Service]
ExecStart=/usr/bin/python3 -I /opt/octet-remote/dac_reboot.py
StandardInput=socket
StandardOutput=journal
StateDirectory=octet-dac-recovery
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
RuntimeMaxSec=90
ReadWritePaths=-/sys/bus/platform/drivers/snd-rpi-simple
ReadWritePaths=-/sys/bus/platform/drivers/designware-i2s
