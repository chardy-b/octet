[Unit]
Description=CamillaDSP
After=sound.target
Wants=sound.target

[Service]
User=octet
Group=audio
# Private network namespace: the websocket listener is reachable only by units that join this
# namespace (octet-dsp-proxy.service), never from the host. Startup is muted at -36 dB.
PrivateNetwork=yes
ExecStart=/opt/camilladsp/camilladsp -p 1234 -a 127.0.0.1 -s /opt/camilladsp/statefile.yml -o /opt/camilladsp/camilladsp.log -w --mute --gain=-36
Restart=always
RestartSec=3
LimitRTPRIO=99
LimitMEMLOCK=infinity
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50

[Install]
WantedBy=multi-user.target
